# Database (Supabase)
# Use Transaction Pooler (Port 6543) for Serverless/Lambda environments if deploying there
# Use Session Pooler (Port 5432) for long-running servers (like this FastAPI app)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:5432/postgres

# Security
SECRET_KEY=your_super_secret_key_here

# LLM Provider (Choose one or both)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# X API Credentials (Required for API Monitor & Posting)
X_API_KEY=...
X_API_SECRET_KEY=...
X_ACCESS_TOKEN=...
X_ACCESS_TOKEN_SECRET=...

# X Account Credentials (Required for Browser Automation)
X_USERNAME=...
X_PASSWORD=...

# Application Settings
LOG_LEVEL=INFO
